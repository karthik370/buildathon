# RevenueGuard environment variables template
# Copy this file to .env and fill in your values

# OpenRouter API key for Tier-2 LLM Diagnosis (Get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Razorpay Test Mode API keys (from https://dashboard.razorpay.com/#/app/keys)
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_key_secret

# Executor mode: 'simulated' (default) or 'razorpay_test'
# Pipeline auto-runs in simulated mode to avoid burning API quota.
# The Approve button in the dashboard always calls the real Razorpay API when configured.
EXECUTOR_MODE=simulated
